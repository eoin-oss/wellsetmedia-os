  "motion": {
    "rule": "nothing hard-cuts: objects build on the spoken word, then move/regroup/morph into the next idea",
    "speed_ramp": "quintic in-out (16t^5), 6-8 frames, motion blur quality 6 shutter 220 on moving groups",
    "pop": "spring damping 11 stiffness 170",
    "title_words": "rise 18px + fade over 4 frames on their cue; block flicks up 40px and out over 4 frames",
