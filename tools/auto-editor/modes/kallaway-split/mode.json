      "pop": "Pop-up-woosh -17",
      "click": "Vintage Click -14",
      "stamp": "Impact 19 -13 (peak)",
      "hit": "Short Bass Hit -15 (peak)",
      "strike": "Glitch 22 -14",
      "flash": "4E_01 S.EF Flash -16"
    },
    "nothing_past_last_frame": true,
    "sfx_rule": "booms/hits, whooshes and flashes 4 dB under the 19 Oct levels (hard rule, all styles)"
